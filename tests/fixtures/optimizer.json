{
  "policiesNamespace": "selftest",
  "schemaVersion": "1.0.0",
  "kind": "linkThresholds",

  "items": [
    { "key": "a", "name": "A 型", "tier": 0 }
  ],

  "structures": [
    { "key": "flat", "mode": "mesh", "adjacentOnly": false }
  ],

  "states": [
    { "key": "green",  "min": 0.75 },
    { "key": "yellow", "min": 0.45 },
    { "key": "red",    "min": 0.0 }
  ],

  "hysteresis": { "riseMargin": 0.05, "fallMargin": 0.05, "confirmCount": 3, "minDwellMs": 0 },

  "metrics": {
    "window": { "windowMs": 1000, "maxSamples": 100 },
    "items": [
      { "key": "up",   "ledgerKey": "up",   "unit": "u", "direction": "higher", "min": 0, "max": 100, "weight": 0.5 },
      { "key": "down", "ledgerKey": "down", "unit": "u", "direction": "lower",  "min": 0, "max": 100, "weight": 0.5 }
    ]
  },

  "evaluation": {
    "stabilityKey": "stability",
    "items": [
      { "key": "stability", "weight": 0.5, "scale": { "min": 0, "max": 1 },
        "terms": [ { "source": "metricScore.up", "weight": 0.5 },
                   { "source": "metricScore.down", "weight": 0.5 } ] },
      { "key": "headroom", "weight": 0.5, "scale": { "min": 0, "max": 1 },
        "terms": [ { "source": "worstScore", "weight": 1.0 } ],
        "requirement": { "metric": "worstScore", "op": ">=", "limit": 0.5 } }
    ]
  },

  "optimization": {
    "objective": { "kind": "evaluationWeighted", "items": [ "stability", "headroom" ] },
    "minImprovement": 0.01,
    "maxIterations": 64,
    "maxMs": 1000,
    "parameters": [
      { "metric": "up",   "min": 0, "max": 100, "step": 10 },
      { "metric": "down", "min": 0, "max": 100, "step": 10 }
    ]
  },

  "curves": { "granularityMs": 1000, "maxPoints": 8, "metrics": [ "up", "down" ] }
}
